# Copy to .env for `docker compose up`, or enter these in Portainer's stack environment variables.
# Never commit a filled-in copy: the calendar URLs are secrets.

HOST_PORT=8088
TZ=America/New_York
LAT=40.7128
LON=-74.0060
LOCATION_NAME=New York
UNITS=imperial

# One line of JSON. Fields per calendar:
#   id        short name, a-z 0-9 _ -           (required)
#   name      label on the frame                (optional)
#   url       Google "Secret address in iCal format" (required, https)
#   color     #rrggbb                           (optional)
#   alert     true = flash before its events    (optional)
#   email     your address on that calendar; hides events you declined (optional)
#   busyOnly  true = show "Busy" instead of titles and locations (optional)
#   exclude   ["regex", ...] titles to hide, case-insensitive (optional)
CALENDARS=[{"id":"work","name":"Work","url":"https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics","color":"#3B6FD8","alert":true,"email":"you@work.example"},{"id":"personal","name":"Personal","url":"https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics","color":"#00A36C"},{"id":"consulting","name":"Consulting","url":"https://calendar.google.com/calendar/ical/REPLACE/private-REPLACE/basic.ics","color":"#C2410C","alert":true}]

REFRESH_MINUTES=5
EVENTS_DAYS=14

# Flash ALERT_LEAD_MIN before an alert:true event, show a countdown from ALERT_COUNTDOWN_MIN,
# and stop flashing ALERT_GRACE_MIN after it starts if nobody tapped ACK.
ALERT_LEAD_MIN=2
ALERT_COUNTDOWN_MIN=15
ALERT_GRACE_MIN=10

# Optional. When set, button presses (ACK, pomodoro) need it: open the frame at
# http://<nas-ip>:8088/?token=<value>. Reads stay open on the LAN.
WRITE_TOKEN=

# Optional. A URL that returns plain text (text/*), shown in the bottom-right card and refreshed
# every 15 seconds, exactly as served. Leave empty to hide the card. The server fetches it (at most
# once per 10 s), accepts only text/* and keeps 2 KB; the frame shows it as text, never HTML. Example:
#   TEXT_FEED_URL=https://dadjokes736.com
TEXT_FEED_URL=
# Optional heading for that card.
TEXT_FEED_TITLE=
